// AUTO-GENERATED BY `./sieve diagram` FROM `expensieve.domain.architecture` — DO NOT EDIT MANUALLY

specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element controlPlane {
    style {
      shape rectangle
      color indigo
    }
  }
  element layer {
    style {
      shape rectangle
      color slate
    }
  }
  element component {
    style {
      shape rectangle
      color blue
    }
  }
  element extractor {
    style {
      shape rectangle
      color sky
    }
  }
  element domainModel {
    style {
      shape cylinder
      color green
    }
  }
  element externalDevice {
    style {
      shape mobile
      color sky
    }
  }
  element externalBrowser {
    style {
      shape browser
      color indigo
    }
  }
  element externalServer {
    style {
      shape storage
      color secondary
    }
  }
  element ledgerStorage {
    style {
      shape cylinder
      color amber
    }
  }

  tag spine
  tag collector
  tag extractorTag
  tag domain
  tag sink
  tag external
}

model {
  // ==========================================================================
  // 1. User & External Telemetry / Financial Sources
  // ==========================================================================
  actor user 'User (Darshan)' {
    description 'Downloads periodic bank statements, executes ./sieve sync, and reviews low-confidence transactions'
  }

  externalServer hdfc_bank 'HDFC Bank NetBanking' {
    #external #spine
    description 'Exports periodic comma-delimited bank statements (.txt / .csv) acting as the immutable accounting spine'
    technology 'Delimited Statement (.txt / .csv)'
  }

  externalDevice pixel_phone 'Google Pixel (Android ADB)' {
    #external #collector
    description 'Provides real-time bank/UPI SMS alerts (content://sms/inbox) and on-device Google Maps Timeline.json'
    technology 'ADB USB / Wireless Debugging'
  }

  externalServer gmail_imap 'Gmail (IMAP SSL)' {
    #external #collector
    description 'Stores PDF ride invoices, food delivery receipts, Amazon confirmations, train/hotel vouchers, and FD/IPO advices'
    technology 'imap.gmail.com:993 (X-GM-RAW)'
  }

  externalBrowser chrome_browser 'Google Chrome (macOS AppleScript / CDP)' {
    #external #collector
    description 'Authenticated browser sessions for Zomato, Zepto, Blinkit, Amazon, and Uber order history'
    technology 'macOS AppleScript JS / JSON Cache'
  }

  externalServer nominatim_api 'OpenStreetMap Nominatim' {
    #external
    description 'Reverse geocodes fallback WGS-84 coordinates into human-readable street and suburb names'
    technology 'nominatim.openstreetmap.org'
  }

  // ==========================================================================
  // 2. Pluggable Target Ledger Sink (Sourdough + Wallet by BudgetBakers)
  // ==========================================================================
  controlPlane sourdough_sdk 'Sourdough SDK & CLI (./dough)' {
    #sink
    description 'Strictly typed Python SDK & CLI for Wallet by BudgetBakers with append-only rollback journaling'
    technology 'Python 3.14+ / uv'
    link https://github.com/Darshan-AS/sourdough 'Sourdough GitHub Repository'
    metadata {
      cli './dough'
      journal 'journal.jsonl'
      safety 'Atomic _bulk_docs + Pre/Post Balance Check'
    }
  }

  ledgerStorage wallet_couchdb 'Wallet by BudgetBakers (CouchDB)' {
    #sink
    description 'Cloud-synced personal finance ledger storing RecordDocument (-Record_), Debt (-Debt_), and HashTag (-HashTag_) documents'
    technology 'Cloudant / CouchDB (_bulk_docs)'
  }

  // ==========================================================================
  // 3. Core System: ExpenSieve (Hexagonal Architecture)
  // ==========================================================================
  controlPlane expensieve 'ExpenSieve (./sieve CLI)' {
    description 'App-agnostic personal expense enrichment engine and multi-source reconciliation pipeline'
    technology 'Python 3.14+ / uv / Hexagonal Architecture'
    link https://github.com/Darshan-AS/expensieve 'ExpenSieve GitHub Repository'
    metadata {
      architecture 'Hexagonal (Ports & Adapters)'
      commands './sieve sync | ./sieve snap | ./sieve diagram'
      metro_stations '55'
      personal_landmarks '58'
    }

    layer cliLayer 'CLI & Presentation Layer (expensieve.cli)' {
      component sieveCli 'Typer CLI App (./sieve)' {
        description 'Provides ./sieve sync, ./sieve snap, and ./sieve diagram commands, Rich summary tables, and staged JSON export'
        technology 'Typer / Rich'
        metadata {
          commands 'sync, snap, diagram'
          output_formats 'Rich Table, Staged JSON'
        }
      }
    }

    layer serviceLayer 'Orchestration & Services Layer (expensieve.services)' {
      component syncPipeline 'SyncPipeline' {
        description 'Coordinates statement parsing, multi-source evidence collection, deterministic merging, balance verification, and sink pushing'
        technology 'Pipeline Orchestrator'
      }

      component evidenceMerger 'EvidenceMerger' {
        description 'Resolves competing EnrichmentEvidence per StatementRow using deterministic EvidencePriority (10..95) and confidence thresholds'
        technology 'Priority Resolver (10..95)'
        metadata {
          priority_95 'EMAIL_PDF_INVOICE'
          priority_85 'MERCHANT_WEB_SCRAPE'
          priority_75 'TIMELINE_GEO'
          priority_60 'EXPLICIT_UPI_REMARK'
          priority_40 'DECLARATIVE_RULE / SMS'
          priority_10 'STATEMENT_FALLBACK'
          review_threshold 'confidence < 0.75 -> Needs Review'
        }
      }
    }

    layer domainLayer 'Pure Domain Core (expensieve.domain)' {
      #domain
      domainModel models 'Canonical Domain Models' {
        #domain
        description 'Immutable value objects: StatementRow, EnrichmentEvidence, CanonicalTransaction, DebtLinkGroup, EvidencePriority, and GeoPoint'
        technology 'Frozen Dataclasses • Minor Units (Paise)'
      }

      component gazetteer 'Namma Metro & Landmark Gazetteer' {
        #domain
        description '55 Purple/Green Line Namma Metro stations, 58 personal landmarks, Haversine snapping, and invoice address normalization'
        technology 'Haversine Geodesic Snapping'
        metadata {
          metro_stations '55 stations (Purple & Green Lines)'
          landmarks '58 curated landmarks'
          metro_snap_radius '900m'
        }
      }

      component declarativeRules 'DeclarativeRuleCollector' {
        #domain #collector
        description 'Classifies UPI remarks, food/snack/beverage keywords, investment transfers, family medical rows, and merchant VPAs'
        technology 'Priority 40..60 (Rule & Remark Classifier)'
      }

      component archCompiler 'Architecture Topology Compiler' {
        #domain
        description 'Pure functional compiler generating architecture/topology.c4 and ARCHITECTURE.md via ./sieve diagram'
        technology 'expensieve.domain.architecture'
      }
    }

    layer portsLayer 'Hexagonal Ports (expensieve.ports)' {
      component protocols 'Structural Protocols (PEP 544)' {
        description 'StatementSource, EvidenceCollector, ReverseGeocoder, and LedgerSink structural interfaces'
        technology 'typing.Protocol'
      }
    }

    layer statementAdapters 'Statement Source Adapters (expensieve.adapters.statements)' {
      #spine
      component hdfcSource 'HdfcDelimitedStatementSource' {
        #spine
        description 'Parses multiline HDFC delimited exports, decomposes UPI narrations (Payee, VPA, 12-digit RRN, Remark), and slices after cutoff_ref'
        technology 'CSV State Machine • UPI Decomposer'
        metadata {
          supported_formats '.txt, .csv (HDFC NetBanking)'
          upi_fields 'Payee, VPA, Bank Code, 12-digit RRN, Remark'
        }
      }

      component hdfcCcPdfSource 'HdfcCreditCardPdfStatementSource' {
        #spine
        description 'Decrypts password-protected HDFC Credit Card monthly PDF statements (from disk or Gmail IMAP) and extracts domestic/international rows'
        technology 'RC4-128 PDF Decryptor • 2D Table Parser'
        metadata {
          supported_formats '.pdf (HDFC Credit Card Statements)'
          sources 'Local PDF file/directory or Gmail IMAP (Emailstatements.cards@hdfcbank.net)'
        }
      }

      component dcbNiyoSource 'DcbNiyoStatementSource' {
        #spine
        description 'Decrypts AES-128-CBC DCB Bank Niyo Global PDF statements, chains post-statement email alerts by available balance, and infers zero-markup Visa SGD/MYR spend'
        technology 'AES-128-CBC PDF Decryptor • Balance Chainer • Forex Inferencer'
        metadata {
          supported_formats '.pdf, dcb_emails.json (DCB Bank Niyo Global)'
          sources 'Local PDF/JSON or Gmail IMAP (bankstatement@dcb.bank.in, alerts@dcb.bank.in)'
        }
      }

      component equitasNiyoSource 'EquitasNiyoStatementSource' {
        #spine
        description 'Decrypts AES-128-CBC + /ObjStm Equitas Small Finance Bank (NiyoX) PDF statement chains and merges Insta-Alert timestamps'
        technology 'AES-128-CBC + /ObjStm PDF Decryptor • Multi-PDF Chainer'
        metadata {
          supported_formats '.pdf (*6096.pdf), niyo_emails.json (Equitas SFB NiyoX)'
          sources 'Local PDF directory/file + Insta-Alerts (customercare@equitasbank.com)'
        }
      }

      component fiFederalSource 'FiFederalStatementSource' {
        #spine
        description 'Decrypts AES-256-CBC (V=5, R=5 /AESV3) Fi Money / Federal Bank PDF statements, merges FedFiB/FIMONY SMS alerts, and backfills dormant-quarter interest'
        technology 'AES-256-CBC PDF Decryptor • SMS Alert Chainer'
        metadata {
          supported_formats '.pdf (Fi Account Statement / Federal Bank), sms_inbox.txt'
          sources 'Local PDF directory/file or Gmail IMAP (statement@epi.fi, fblcustomercare@federalbank.co.in)'
        }
      }
    }

    layer collectorAdapters 'Evidence Collector Adapters (expensieve.adapters.collectors)' {
      #collector
      component adbSmsCollector 'AdbSmsCollector' {
        #collector
        description 'Queries Pixel SMS inbox over ADB and matches 12-digit UPI RRNs to recover exact second-level UTC transaction timestamps'
        technology 'Priority 40 (ADB content://sms/inbox)'
        metadata {
          match_keys '12-digit RRN (primary), Date + Amount (fallback)'
          timestamp_precision '1 second (UTC)'
        }
      }

      component timelineGeoCollector 'TimelineGeoCollector' {
        #collector
        description 'Matches SMS UTC timestamps against Google Maps Timeline.json IN_SUBWAY, activity segments, and place visits'
        technology 'Priority 75 (TIMELINE_GEO)'
        metadata {
          subway_matching 'IN_SUBWAY -> Metro, <Origin> to <Dest>'
          ride_matching 'IN_PASSENGER_VEHICLE -> Auto/Cab route'
          qr_matching 'BharatPe / Paytm / Vyapar -> Visit Place'
        }
      }

      component merchantWebCollector 'CachedMerchantOrderCollector' {
        #collector
        description 'Extracts and matches itemized orders from Zomato, Zepto, Blinkit, Amazon, and Uber via Chrome AppleScript or JSON cache'
        technology 'Priority 85 (MERCHANT_WEB_SCRAPE)'
        metadata {
          merchants 'Zomato, Zepto, Blinkit, Amazon, Uber'
          pharmacy_detection 'Zepto & Amazon medicine keyword classifier'
          sub_shipments 'Blinkit & Amazon multi-shipment aggregation'
        }
      }

      component gmailImapCollector 'GmailImapCollector' {
        #collector
        description 'Connects to imap.gmail.com and dispatches decoded MIME messages & PDF attachments to 7 pluggable ReceiptExtractor strategies'
        technology 'Priority 95 (INVOICE_PDF)'
        metadata {
          protocol 'IMAP4_SSL (imap.gmail.com:993)'
          extractors '7 pluggable ReceiptExtractor strategies'
        }

        extractor imapDispatcher 'IMAP MIME Fetcher & Strategy Dispatcher' {
          #extractorTag
          description 'Executes X-GM-RAW queries, decodes RFC822 multipart bodies & PDF attachments, and routes to extractors'
          technology 'imaplib + email.message'
        }

        extractor pdfTextEngine 'Pure-Python RC4/AES & 2D PDF Layout Engine (pdf_text)' {
          #extractorTag
          description 'Decrypts RC4-128, AES-128-CBC, & AES-256-CBC Standard Security streams, decompresses FlateDecode, parses /ToUnicode CMaps, and sorts blocks by 2D (page, Y, X) coordinates'
          technology 'RC4 + AES-128/256-CBC + MD5/SHA-256 + zlib + /ToUnicode CMap (Zero C Deps)'
          metadata {
            encryption 'PDF Standard Security Handler V1/V2/V4/V5 R2/R3/R4/R5 (RC4-128, AESV2 & AESV3)'
            stream_codec 'FlateDecode (zlib)'
            glyph_mapping 'beginbfchar & beginbfrange UTF-16BE'
            layout_sorting '2D Coordinate Clustering (page, -Y, X)'
          }
        }

        extractor nammaYatriExtractor 'NammaYatriPdfExtractor' {
          #extractorTag
          description 'Extracts multi-ride auto fares, IST timestamps, and pickup/drop routes from Namma Yatri PDF invoices'
          technology 'from:nammayatri.in (invoice_*.pdf)'
        }

        extractor rapidoExtractor 'RapidoReceiptExtractor' {
          #extractorTag
          description 'Extracts Auto/Cab mode, fares, and pickup/drop addresses from Rapido PDF receipts and HTML emails'
          technology 'from:rapido.bike (AUTO/CAB_RECEIPT_*.pdf)'
        }

        extractor swiggyExtractor 'SwiggyReceiptExtractor' {
          #extractorTag
          description 'Extracts restaurant names and ordered dishes from Swiggy delivery confirmation emails'
          technology 'from:noreply@swiggy.in'
        }

        extractor amazonEmailExtractor 'AmazonEmailExtractor' {
          #extractorTag
          description 'Extracts single/multi-shipment items and classifies Pharmacy, Groceries (Fresh), Electronics, Wellness, and Shopping'
          technology 'from:auto-confirm@amazon.in'
        }

        extractor travelExtractor 'TravelBookingExtractor' {
          #extractorTag
          description 'Extracts ConfirmTkt/IRCTC train routes & PNRs, MakeMyTrip hotel bookings, Grab ride receipts (MYR/SGD), and Encore Melaka show PDFs'
          technology 'ConfirmTkt • IRCTC • MakeMyTrip • Grab • Encore Melaka'
        }

        extractor investmentExtractor 'InvestmentEmailExtractor' {
          #extractorTag
          description 'Extracts Gullak gold certificates, INDmoney (US Stocks .xls, Indian Stocks Contract Note .pdf, MFs), CDSL/KFintech/MUFG IPOs & REITs, and Shriram Finance FDs'
          technology 'Gullak • INDmoney • CDSL • KFintech • MUFG • Shriram'
        }

        extractor hdfcCcExtractor 'HdfcCreditCardExtractor' {
          #extractorTag
          description 'Extracts exact second-level IST timestamps from HDFC Credit Card InstaAlerts and bill-payment transfers from encrypted CC PDFs'
          technology 'alerts@hdfcbank.net • Emailstatements.cards@hdfcbank.net'
        }
      }
    }

    layer geocodingAdapters 'Geocoding Adapters (expensieve.adapters.geocoding)' {
      component nominatimGeocoder 'CachedNominatimGeocoder' {
        description 'SQLite-backed (~110m grid) reverse geocoder calling OpenStreetMap Nominatim only on cache misses'
        technology 'SQLite Cache + Nominatim HTTPS'
      }
    }

    layer sinkAdapters 'Ledger Sink Adapters (expensieve.adapters.sinks)' {
      #sink
      component sourdoughSink 'SourdoughLedgerSink' {
        #sink
        description 'Translates app-agnostic CanonicalTransactions and DebtLinkGroups into Sourdough Wallet records and atomic bulk_docs writes'
        technology 'Wallet by BudgetBakers Adapter'
      }
    }
  }

  // ==========================================================================
  // 4. Cross-Component Relationships
  // ==========================================================================
  user -> hdfc_bank 'Downloads periodic bank statement (.txt / .csv)'
  user -> expensieve.cliLayer.sieveCli 'Invokes ./sieve sync, ./sieve snap & ./sieve diagram'
  expensieve.cliLayer.sieveCli -> expensieve.serviceLayer.syncPipeline 'Configures adapters and triggers sync pipeline'
  expensieve.cliLayer.sieveCli -> expensieve.domainLayer.archCompiler 'Compiles topology.c4 & ARCHITECTURE.md (./sieve diagram)'
  expensieve.cliLayer.sieveCli -> expensieve.domainLayer.gazetteer 'Snaps WGS-84 coordinates (./sieve snap)'

  // Pipeline Orchestration
  expensieve.serviceLayer.syncPipeline -> expensieve.portsLayer.protocols 'Depends exclusively on PEP 544 structural Protocols'
  expensieve.serviceLayer.syncPipeline -> expensieve.statementAdapters.hdfcSource '1a. Parses new bank StatementRows after cutoff RRN'
  expensieve.serviceLayer.syncPipeline -> expensieve.statementAdapters.hdfcCcPdfSource '1b. Decrypts & parses HDFC Credit Card PDF StatementRows'
  expensieve.serviceLayer.syncPipeline -> expensieve.statementAdapters.dcbNiyoSource '1c. Decrypts DCB Niyo PDF & chains post-statement alerts'
  expensieve.serviceLayer.syncPipeline -> expensieve.statementAdapters.equitasNiyoSource '1d. Decrypts Equitas NiyoX PDF statement chain & alerts'
  expensieve.serviceLayer.syncPipeline -> expensieve.statementAdapters.fiFederalSource '1e. Decrypts Fi Money / Federal Bank AES-256 PDFs & merges SMS alerts'
  expensieve.serviceLayer.syncPipeline -> expensieve.domainLayer.declarativeRules '2a. Collects baseline rule & UPI remark evidence (Priority 40..60)'
  expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.adbSmsCollector '2b. Collects exact UTC timestamps by 12-digit RRN (Priority 40)'
  expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.timelineGeoCollector '2c. Collects Metro/Auto/QR route & venue evidence (Priority 75)'
  expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.merchantWebCollector '2d. Collects Zomato/Zepto/Blinkit/Amazon/Uber items (Priority 85)'
  expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.gmailImapCollector '2e. Collects PDF & email invoice evidence (Priority 95)'
  expensieve.serviceLayer.syncPipeline -> expensieve.serviceLayer.evidenceMerger '3. Merges all EnrichmentEvidence into CanonicalTransactions'
  expensieve.serviceLayer.syncPipeline -> expensieve.sinkAdapters.sourdoughSink '4. Pushes verified CanonicalTransactions (dry-run or live)'

  // Domain & Merger
  expensieve.serviceLayer.evidenceMerger -> expensieve.domainLayer.models 'Produces CanonicalTransaction & verifies opening + sum(delta) == closing'
  expensieve.domainLayer.declarativeRules -> expensieve.domainLayer.models 'Emits EnrichmentEvidence'
  expensieve.domainLayer.gazetteer -> expensieve.domainLayer.models 'Snaps GeoPoint & normalizes addresses'

  // Statement Adapters
  expensieve.statementAdapters.hdfcSource -> hdfc_bank 'Reads delimited statement file'
  expensieve.statementAdapters.hdfcSource -> expensieve.domainLayer.models 'Emits StatementRow accounting spine'
  expensieve.statementAdapters.hdfcCcPdfSource -> gmail_imap 'Fetches encrypted monthly Credit Card PDFs'
  expensieve.statementAdapters.hdfcCcPdfSource -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Decrypts RC4-128 streams & extracts 2D table rows'
  expensieve.statementAdapters.hdfcCcPdfSource -> expensieve.domainLayer.models 'Emits StatementRow accounting spine'
  expensieve.statementAdapters.dcbNiyoSource -> gmail_imap 'Fetches encrypted DCB Bank PDFs & real-time transaction alerts'
  expensieve.statementAdapters.dcbNiyoSource -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Decrypts AES-128-CBC streams & extracts 2D table rows'
  expensieve.statementAdapters.dcbNiyoSource -> expensieve.domainLayer.models 'Emits StatementRow accounting spine with inferred SGD/MYR forex'
  expensieve.statementAdapters.equitasNiyoSource -> gmail_imap 'Reads encrypted Equitas PDFs & Insta-Alerts'
  expensieve.statementAdapters.equitasNiyoSource -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Decrypts AES-128-CBC + /ObjStm streams & extracts 2D table rows'
  expensieve.statementAdapters.equitasNiyoSource -> expensieve.domainLayer.models 'Emits StatementRow accounting spine'
  expensieve.statementAdapters.fiFederalSource -> gmail_imap 'Fetches encrypted Fi Money / Federal Bank PDF statements'
  expensieve.statementAdapters.fiFederalSource -> pixel_phone 'Reads FedFiB & FIMONY SMS alerts'
  expensieve.statementAdapters.fiFederalSource -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Decrypts AES-256-CBC (V=5, R=5) streams & extracts 2D table rows'
  expensieve.statementAdapters.fiFederalSource -> expensieve.domainLayer.models 'Emits StatementRow accounting spine'

  // Collectors & External Systems
  expensieve.collectorAdapters.adbSmsCollector -> pixel_phone 'Queries content://sms/inbox over ADB'
  expensieve.collectorAdapters.timelineGeoCollector -> pixel_phone 'Reads exported Google Maps Timeline.json'
  expensieve.collectorAdapters.timelineGeoCollector -> expensieve.domainLayer.gazetteer 'Snaps WGS-84 coordinates to Namma Metro stations & landmarks'
  expensieve.collectorAdapters.timelineGeoCollector -> expensieve.geocodingAdapters.nominatimGeocoder 'Reverse geocodes unknown coordinates'
  expensieve.geocodingAdapters.nominatimGeocoder -> nominatim_api 'Queries HTTPS reverse geocoding on SQLite cache miss'
  expensieve.collectorAdapters.merchantWebCollector -> chrome_browser 'Executes AppleScript JS on open Zomato/Zepto/Amazon tabs'

  // Gmail & Pluggable Extractors
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> gmail_imap 'Searches X-GM-RAW & fetches RFC822 MIME messages over IMAP SSL'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.nammaYatriExtractor 'Dispatches from:nammayatri.in messages'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.rapidoExtractor 'Dispatches from:rapido.bike messages'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.swiggyExtractor 'Dispatches from:noreply@swiggy.in messages'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.amazonEmailExtractor 'Dispatches from:auto-confirm@amazon.in messages'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.travelExtractor 'Dispatches ConfirmTkt / IRCTC / MakeMyTrip messages'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.investmentExtractor 'Dispatches Shriram Finance / KFintech / MUFG IPO messages'
  expensieve.collectorAdapters.gmailImapCollector.imapDispatcher -> expensieve.collectorAdapters.gmailImapCollector.hdfcCcExtractor 'Dispatches HDFC Credit Card InstaAlerts & Statement PDFs'

  expensieve.collectorAdapters.gmailImapCollector.nammaYatriExtractor -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Extracts 2D-sorted lines from invoice_*.pdf'
  expensieve.collectorAdapters.gmailImapCollector.rapidoExtractor -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Extracts 2D-sorted lines from AUTO/CAB_RECEIPT_*.pdf'
  expensieve.collectorAdapters.gmailImapCollector.hdfcCcExtractor -> expensieve.collectorAdapters.gmailImapCollector.pdfTextEngine 'Decrypts RC4-128 Credit Card PDFs & extracts rows'
  expensieve.collectorAdapters.gmailImapCollector.nammaYatriExtractor -> expensieve.domainLayer.gazetteer 'Normalizes raw pickup/drop addresses to landmarks'
  expensieve.collectorAdapters.gmailImapCollector.rapidoExtractor -> expensieve.domainLayer.gazetteer 'Normalizes raw pickup/drop addresses to landmarks'

  // Sink Adapter
  expensieve.sinkAdapters.sourdoughSink -> sourdough_sdk 'Resolves categories/labels and builds RecordDocument payloads'
  sourdough_sdk -> wallet_couchdb 'Pushes atomic _bulk_docs and records local rollback journal.jsonl'
}

views {
  // 1. Overarching System Landscape
  view index {
    title '1. Overarching System Landscape (End-to-End Stack)'
    description 'High-level map of User, ExpenSieve CLI, external financial/telemetry sources (HDFC, Pixel ADB, Gmail IMAP, Chrome, Nominatim), and the Sourdough / Wallet CouchDB sink'
    include
      user,
      hdfc_bank,
      pixel_phone,
      gmail_imap,
      chrome_browser,
      nominatim_api,
      expensieve,
      sourdough_sdk,
      wallet_couchdb
    autoLayout LeftRight
  }

  // 2. Hexagonal Architecture View
  view hexagonal_view of expensieve {
    title '2. ExpenSieve Hexagonal Architecture — Ports, Adapters & Domain Core'
    description 'Internal layered architecture of ExpenSieve showing the CLI, SyncPipeline, EvidenceMerger, Pure Domain Core, and Driven/Driving Adapters'
    include
      *,
      expensieve.*,
      expensieve.cliLayer.*,
      expensieve.serviceLayer.*,
      expensieve.domainLayer.*,
      expensieve.portsLayer.*,
      expensieve.statementAdapters.*,
      expensieve.collectorAdapters.*,
      expensieve.geocodingAdapters.*,
      expensieve.sinkAdapters.*
    autoLayout LeftRight
  }

  // 3. Multi-Source Collectors View
  view collectors_view of expensieve.collectorAdapters {
    title '3. Multi-Source Evidence Collectors — ADB SMS, Timeline, Chrome & Gmail'
    description 'Drill-down into the 4 external evidence collector adapters and how they connect to Pixel ADB, Google Maps Timeline, Chrome, Gmail, and Gazetteer'
    include
      *,
      expensieve.collectorAdapters.*,
      pixel_phone,
      gmail_imap,
      chrome_browser,
      nominatim_api,
      expensieve.domainLayer.gazetteer,
      expensieve.geocodingAdapters.nominatimGeocoder,
      expensieve.serviceLayer.syncPipeline
    autoLayout LeftRight
  }

  // 4. Gmail IMAP & Pure-Python 2D PDF Engine Drill-Down
  view gmail_pdf_view of expensieve.collectorAdapters.gmailImapCollector {
    title '4. Gmail IMAP & Pure-Python 2D PDF Layout Engine Drill-Down'
    description 'Drill-down into GmailImapCollector showing the 6 pluggable ReceiptExtractor strategies and the pure-Python FlateDecode + /ToUnicode CMap PDF engine'
    include
      *,
      expensieve.collectorAdapters.gmailImapCollector.*,
      gmail_imap,
      expensieve.domainLayer.gazetteer,
      expensieve.serviceLayer.syncPipeline
    autoLayout LeftRight
  }

  // 5. Pure Domain Core & Priority Resolution View
  view domain_merger_view of expensieve.domainLayer {
    title '5. Pure Domain Core — Gazetteer Snapping, Rules & Evidence Priority Merger'
    description 'Zero-I/O domain models, 55 Namma Metro stations & 58 landmarks, DeclarativeRuleCollector, and EvidenceMerger (Priority 10..95)'
    include
      *,
      expensieve.domainLayer.*,
      expensieve.serviceLayer.evidenceMerger,
      expensieve.serviceLayer.syncPipeline,
      expensieve.statementAdapters.hdfcSource
    autoLayout LeftRight
  }

  // 6. Ledger Sink Drill-Down View
  view sink_view of expensieve.sinkAdapters {
    title '6. Ledger Sink — Sourdough SDK, CouchDB Atomic Bulk Push & Rollback Journal'
    description 'How SourdoughLedgerSink validates opening/closing balances, resolves categories/labels/debts, and commits atomically to Wallet by BudgetBakers'
    include
      *,
      expensieve.sinkAdapters.*,
      expensieve.serviceLayer.syncPipeline,
      expensieve.domainLayer.models,
      sourdough_sdk,
      wallet_couchdb
    autoLayout LeftRight
  }

  // 7. Dynamic Flow 1: End-to-End Reconciliation & Enrichment Pipeline
  dynamic view sync_pipeline_flow {
    title '7. Dynamic Flow: End-to-End Statement Reconciliation & Enrichment (./sieve sync)'
    description 'Step-by-step runtime execution trace from HDFC bank statement ingestion to atomic CouchDB commit'

    user -> expensieve.cliLayer.sieveCli '1. Invokes ./sieve sync --statement Acct_Statement.txt'
    expensieve.cliLayer.sieveCli -> expensieve.serviceLayer.syncPipeline '2. Initializes pipeline with configured collectors'
    expensieve.serviceLayer.syncPipeline -> expensieve.statementAdapters.hdfcSource '3. Parses statement & slices rows after cutoff_ref'
    expensieve.serviceLayer.syncPipeline -> expensieve.domainLayer.declarativeRules '4. Runs regex & UPI remark rules (Priority 40..60)'
    expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.adbSmsCollector '5. Matches 12-digit UPI RRNs to Pixel SMS for exact UTC timestamps'
    expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.timelineGeoCollector '6. Snaps SMS UTC timestamps to Google Maps Timeline.json & Namma Metro Gazetteer (Priority 75)'
    expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.merchantWebCollector '7. Matches Zomato, Zepto, Blinkit, Amazon & Uber orders (Priority 85)'
    expensieve.serviceLayer.syncPipeline -> expensieve.collectorAdapters.gmailImapCollector '8. Extracts Namma Yatri & Rapido PDFs, Swiggy, Amazon, Train & Investment emails (Priority 95)'
    expensieve.serviceLayer.syncPipeline -> expensieve.serviceLayer.evidenceMerger '9. Merges all evidence by priority, flags low-confidence rows as Needs Review, & verifies exact closing balance'
    expensieve.serviceLayer.syncPipeline -> expensieve.sinkAdapters.sourdoughSink '10. Pushes verified CanonicalTransactions to Sourdough sink'
    expensieve.sinkAdapters.sourdoughSink -> sourdough_sdk '11. Resolves categories/labels and executes atomic bulk_docs'
    sourdough_sdk -> wallet_couchdb '12. Commits records & writes rollback journal entry'

    autoLayout TopBottom
  }

  // 8. Dynamic Flow 2: UPI RRN -> Pixel SMS UTC -> Timeline GPS -> Gazetteer Snapping
  dynamic view geo_snapping_flow {
    title '8. Dynamic Flow: UPI RRN -> Pixel SMS UTC -> Timeline GPS -> Gazetteer Snapping'
    description 'How a date-only bank statement row recovers its exact second-level timestamp and snaps to Namma Metro stations or local QR venues'

    expensieve.statementAdapters.hdfcSource -> expensieve.domainLayer.models '1. Extracts 12-digit UPI RRN from HDFC narration (date-only row)'
    expensieve.collectorAdapters.adbSmsCollector -> pixel_phone '2. Queries content://sms/inbox and matches 12-digit RRN to recover exact UTC second'
    expensieve.collectorAdapters.timelineGeoCollector -> pixel_phone '3. Intersects exact UTC timestamp with Timeline.json IN_SUBWAY / IN_PASSENGER_VEHICLE / visit segments'
    expensieve.collectorAdapters.timelineGeoCollector -> expensieve.domainLayer.gazetteer '4. Snaps start/end WGS-84 coordinates against 55 Namma Metro stations & 58 landmarks'
    expensieve.collectorAdapters.timelineGeoCollector -> expensieve.geocodingAdapters.nominatimGeocoder '5. Falls back to SQLite-cached Nominatim reverse geocoder for unknown coordinates'
    expensieve.geocodingAdapters.nominatimGeocoder -> nominatim_api '6. Queries OpenStreetMap Nominatim HTTPS API only on SQLite cache miss'

    autoLayout TopBottom
  }
}
